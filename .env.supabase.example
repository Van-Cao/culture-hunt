# Copy these lines into .env.local; keep any existing Auth.js/Gemini settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. NEVER add NEXT_PUBLIC_ to this name.
SUPABASE_SECRET_KEY=

# Legacy keys are supported as alternatives (use only one key per purpose):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
