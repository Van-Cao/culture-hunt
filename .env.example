# Copy to .env.local. Never commit real credentials.
# Create a Web application OAuth client in Google Cloud Console.
# Authorized redirect URI for local development:
# http://localhost:3000/api/auth/callback/google
# Add https://YOUR_DOMAIN/api/auth/callback/google for production.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Generate with: npx auth secret
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Optional: identify new camera angles with OpenAI Vision.
# Without a key, the bundled photo kit and near-identical reference uploads still work.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini
# Optional OpenAI-compatible API base; defaults to https://api.openai.com/v1
# OPENAI_BASE_URL=
# Persistent SQLite directory; defaults to .culture-hunt/ in this project.
# CULTURE_HUNT_DATA_DIR=
