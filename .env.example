# Copy to .env.local. Never commit database passwords or real credentials.
# Supabase Dashboard > Project Settings > API Keys > Publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase Connect > Transaction pooler (port 6543): Vercel runtime.
DATABASE_URL=
# Supabase Connect > Session pooler (port 5432): migrations and local import.
DIRECT_URL=

# Internal demo: enable Email sign-in and disable Confirm email in Supabase.
# Google OAuth / Auth.js configuration is not used.

# Optional: identify new camera angles with OpenAI Vision.
# Without a key, the bundled photo kit and near-identical references still work.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=

# Optional offline-only development/test backend. Never use SQLite on Vercel.
# CULTURE_HUNT_STORAGE=sqlite
# CULTURE_HUNT_DATA_DIR=
